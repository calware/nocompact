{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "claude-code": ["./.claude-plugin/types/claude-code/index.d.ts"] }
  },
  "include": ["src", "tests", "hooks"]
}
